name: c2c-monitor

on:
  # 通过 API 触发，支持传入参数
  workflow_dispatch:
    inputs:
      environment:
        description: "运行环境"
        required: false
        default: "production"
        type: choice
        options:
          - production
          - staging

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"

      - name: 缓存 pip
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-${{ hashFiles('pyproject.toml') }}

      - name: 安装 ruff
        run: pip install ruff

      - name: ruff lint
        run: ruff check .

      - name: ruff format check
        run: ruff format --check .

  run:
    name: Run Script
    runs-on: ubuntu-latest
    needs: lint        # lint 通过才跑脚本

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.10"

      - name: 缓存 pip
        uses: actions/cache@v4
        with:
          path: ~/.cache/pip
          key: ${{ runner.os }}-pip-${{ hashFiles('pyproject.toml') }}

      - name: 安装依赖
        run: pip install -e .

      - name: 运行脚本
        run: python src/main.py
        env:
          ENVIRONMENT: ${{ inputs.environment }}
          # 敏感信息从 GitHub Secrets 读取，不要硬编码在代码里
          # API_KEY: ${{ secrets.API_KEY }}
